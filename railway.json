{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/Dockerfile.web",
    "watchPatterns": [
      "apps/web/**",
      "packages/block-editor/**",
      "Dockerfile.web",
      "package.json",
      "bun.lock",
      "turbo.json",
      "railway.json",
      ".dockerignore"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
