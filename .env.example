# Public URL used by ATProto OAuth client metadata and callbacks.
APP_PUBLIC_URL=http://localhost:8080

# Frontend -> backend API base.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Local storage paths.
DATABASE_URL=sqlite://data/anypub.sqlite
UPLOADS_DIR=data/uploads

# Comma-separated origins allowed to call the API in local dev.
ALLOWED_ORIGINS=http://localhost:3000

# Required for Unsplash cover search.
UNSPLASH_ACCESS_KEY=

# Required before storing real OAuth sessions outside local development.
TOKEN_ENCRYPTION_KEY=

# ATProto OAuth client metadata.
OAUTH_CLIENT_NAME=AnyPub
OAUTH_CLIENT_LOGO_URL=
OAUTH_CLIENT_TOS_URL=
OAUTH_CLIENT_POLICY_URL=
