# Public URL used by ATProto OAuth client metadata and callbacks.
APP_PUBLIC_URL=http://localhost:8080

# Browser URL used as the safe post-OAuth redirect origin.
WEB_PUBLIC_URL=http://localhost:3000

# Frontend -> backend API base.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Non-production UI label. Use dev on Railway development; omit in production.
APP_ENV=local

# Local storage paths.
DATABASE_URL=sqlite://data/anypub.sqlite
UPLOADS_DIR=data/uploads

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# Required for Unsplash cover search.
UNSPLASH_ACCESS_KEY=

# Required before storing real OAuth sessions outside local development.
TOKEN_ENCRYPTION_KEY=

# ATProto OAuth client metadata.
OAUTH_CLIENT_NAME=AnyPub
OAUTH_CLIENT_LOGO_URL=
OAUTH_CLIENT_TOS_URL=
OAUTH_CLIENT_POLICY_URL=
